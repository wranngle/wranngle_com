{
  "name": "wranngle_com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "wranngle.com — marketing site + serverless lead capture for Wranngle Systems (voice AI for busy teams).",
  "author": "Cody Arnold <cody@wranngle.com>",
  "homepage": "https://wranngle.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wranngle/wranngle_com.git"
  },
  "patchedDependencies": {
    "autoprefixer@10.4.23": "patches/autoprefixer@10.4.23.patch",
    "tailwindcss@3.4.19": "patches/tailwindcss@3.4.19.patch",
    "vite@7.3.1": "patches/vite@7.3.1.patch"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:functions": "wrangler pages dev dist --live-reload",
    "build": "bun run script/build.ts",
    "preview": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist",
    "deploy:live": "bun run build && wrangler pages deploy dist --project-name wranngle-com --branch main --commit-dirty=true",
    "deploy:upload": "wrangler pages deploy dist --project-name wranngle-com --branch main --commit-dirty=true",
    "check": "tsc",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "email:build": "bun run email-templates/build/template-builder.ts",
    "email:preview": "bun run email-templates/build/generate-previews.ts && open email-templates/preview/index.html",
    "email:preview:all": "bun run email-templates/build/generate-previews.ts",
    "email:test": "bun run email-templates/build/test-templates.ts",
    "email:test:e2e": "bun test email-templates/build/email-templates.test.ts",
    "email:test:send": "bun run scripts/email-e2e-test.ts",
    "n8n:build": "bun run scripts/build-n8n-email.ts",
    "n8n:deploy": "bun run scripts/build-n8n-email.ts --deploy",
    "smtp:health": "bun run scripts/smtp2go-health.ts",
    "smtp:clear": "bun run scripts/smtp2go-health.ts --clear-suppression",
    "test:smoke": "bun run scripts/smoke-test-intake.ts",
    "test:stress": "bun run scripts/smoke-test-intake.ts --stress --count=10",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:integration": "RUN_LIVE_INTEGRATION=1 vitest run tests/integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.60.5",
    "arktype": "^2.1.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.13.1",
    "input-otp": "^1.4.2",
    "juice": "^11.1.0",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "xo": "^1.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.6",
    "@types/node": "20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18",
    "wrangler": "^3.105.0"
  }
}
