{
  "name": "[DEV] Wranngle Lead Intake Workflow",
  "nodes": [
    {
      "id": "webhook-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "wranngle-intake-form",
      "parameters": {
        "path": "wranngle-intake-form",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "{ \"success\": true, \"message\": \"Lead received\" }",
        "options": {}
      }
    },
    {
      "id": "set-1",
      "name": "Format Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [450, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "timestamp",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "businessName",
              "name": "businessName",
              "value": "={{ $json.body.businessName }}",
              "type": "string"
            },
            {
              "id": "industry",
              "name": "industry",
              "value": "={{ $json.body.industry }}",
              "type": "string"
            },
            {
              "id": "ownerName",
              "name": "ownerName",
              "value": "={{ $json.body.ownerName }}",
              "type": "string"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $json.body.phone }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "package",
              "name": "package",
              "value": "={{ $json.body.package }}",
              "type": "string"
            },
            {
              "id": "status",
              "name": "status",
              "value": "={{ $json.body.status || 'pending' }}",
              "type": "string"
            },
            {
              "id": "notes",
              "name": "notes",
              "value": "={{ $json.body.notes || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "googleSheets-1",
      "name": "Store in Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [650, 250],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.timestamp }}",
            "businessName": "={{ $json.businessName }}",
            "industry": "={{ $json.industry }}",
            "ownerName": "={{ $json.ownerName }}",
            "phone": "={{ $json.phone }}",
            "email": "={{ $json.email }}",
            "package": "={{ $json.package }}",
            "status": "={{ $json.status }}",
            "notes": "={{ $json.notes }}"
          },
          "matchingColumns": [],
          "schema": [
            {"id": "timestamp", "displayName": "Timestamp", "required": false, "type": "string"},
            {"id": "businessName", "displayName": "Business Name", "required": false, "type": "string"},
            {"id": "industry", "displayName": "Industry", "required": false, "type": "string"},
            {"id": "ownerName", "displayName": "Owner Name", "required": false, "type": "string"},
            {"id": "phone", "displayName": "Phone", "required": false, "type": "string"},
            {"id": "email", "displayName": "Email", "required": false, "type": "string"},
            {"id": "package", "displayName": "Package", "required": false, "type": "string"},
            {"id": "status", "displayName": "Status", "required": false, "type": "string"},
            {"id": "notes", "displayName": "Notes", "required": false, "type": "string"}
          ]
        },
        "options": {}
      },
      "notes": "TODO: Configure Google Sheets credential and select the spreadsheet to store leads"
    },
    {
      "id": "email-1",
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [650, 400],
      "parameters": {
        "fromEmail": "noreply@wranngle.com",
        "toEmail": "leads@wranngle.com",
        "subject": "New Lead: ={{ $json.businessName }}",
        "emailType": "html",
        "message": "<h2>New Lead Received</h2>\n<p><strong>Business:</strong> {{ $json.businessName }}</p>\n<p><strong>Industry:</strong> {{ $json.industry }}</p>\n<p><strong>Owner:</strong> {{ $json.ownerName }}</p>\n<p><strong>Phone:</strong> {{ $json.phone }}</p>\n<p><strong>Email:</strong> {{ $json.email }}</p>\n<p><strong>Package:</strong> {{ $json.package }}</p>\n<p><strong>Status:</strong> {{ $json.status }}</p>\n<p><strong>Notes:</strong> {{ $json.notes }}</p>\n<p><strong>Timestamp:</strong> {{ $json.timestamp }}</p>",
        "options": {}
      },
      "notes": "TODO: Configure email credential (SMTP or SendGrid) and update recipient email address"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Format Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Lead Data": {
      "main": [
        [
          {
            "node": "Store in Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Email Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [
    {
      "name": "dev"
    },
    {
      "name": "leads"
    }
  ]
}
