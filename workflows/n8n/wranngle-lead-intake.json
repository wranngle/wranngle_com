{
  "name": "[DEV] Wranngle Lead Intake Workflow",
  "nodes": [
    {
      "id": "webhook-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "wranngle-intake-form",
      "parameters": {
        "path": "wranngle-intake-form",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "{ \"success\": true, \"message\": \"Lead received\" }",
        "options": {}
      }
    },
    {
      "id": "set-1",
      "name": "Format Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [450, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "timestamp",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "businessName",
              "name": "businessName",
              "value": "={{ $json.body.businessName }}",
              "type": "string"
            },
            {
              "id": "industry",
              "name": "industry",
              "value": "={{ $json.body.industry }}",
              "type": "string"
            },
            {
              "id": "ownerName",
              "name": "ownerName",
              "value": "={{ $json.body.ownerName }}",
              "type": "string"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $json.body.phone }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "package",
              "name": "package",
              "value": "={{ $json.body.package }}",
              "type": "string"
            },
            {
              "id": "agentName",
              "name": "agentName",
              "value": "={{ $json.body.agentName || '' }}",
              "type": "string"
            },
            {
              "id": "status",
              "name": "status",
              "value": "={{ $json.body.status || 'pending' }}",
              "type": "string"
            },
            {
              "id": "notes",
              "name": "notes",
              "value": "={{ $json.body.notes || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "database-1",
      "name": "Store in n8n Database",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [650, 250],
      "parameters": {
        "staticData": {
          "tableName": "wranngle_leads"
        }
      },
      "notes": "Stores leads in n8n's internal database table 'wranngle_leads'. Access via Database menu in n8n UI."
    },
    {
      "id": "email-1",
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [650, 400],
      "parameters": {
        "fromEmail": "noreply@wranngle.com",
        "toEmail": "sales@wranngle.com",
        "subject": "🔔 New Lead: {{ $json.businessName }}",
        "emailType": "html",
        "message": "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px;\">\n  <h2 style=\"color: #ff5f00; border-bottom: 3px solid #ff5f00; padding-bottom: 10px;\">🎯 New Lead Received</h2>\n  \n  <div style=\"background: #f9f9f9; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n    <h3 style=\"margin-top: 0; color: #333;\">Business Information</h3>\n    <p><strong>Business Name:</strong> {{ $json.businessName }}</p>\n    <p><strong>Industry:</strong> {{ $json.industry }}</p>\n    <p><strong>Owner/Contact:</strong> {{ $json.ownerName }}</p>\n  </div>\n  \n  <div style=\"background: #f0f8ff; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n    <h3 style=\"margin-top: 0; color: #333;\">Contact Details</h3>\n    <p><strong>📧 Email:</strong> <a href=\"mailto:{{ $json.email }}\">{{ $json.email }}</a></p>\n    <p><strong>📞 Phone:</strong> <a href=\"tel:{{ $json.phone }}\">{{ $json.phone }}</a></p>\n  </div>\n  \n  <div style=\"background: #fff5f0; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n    <h3 style=\"margin-top: 0; color: #333;\">Package & Details</h3>\n    <p><strong>Package Selected:</strong> <span style=\"background: #ff5f00; color: white; padding: 3px 10px; border-radius: 3px; text-transform: uppercase;\">{{ $json.package }}</span></p>\n    <p><strong>Agent Name:</strong> {{ $json.agentName || 'Not specified' }}</p>\n    <p><strong>Status:</strong> {{ $json.status }}</p>\n    {{#if $json.notes}}\n    <p><strong>Additional Notes:</strong></p>\n    <p style=\"background: white; padding: 10px; border-left: 3px solid #ff5f00;\">{{ $json.notes }}</p>\n    {{/if}}\n  </div>\n  \n  <div style=\"text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid #ddd; color: #666; font-size: 12px;\">\n    <p>Received: {{ $json.timestamp }}</p>\n    <p>Wranngle Systems Lead Intake | <a href=\"https://n8n.wranngle.com\">View in n8n</a></p>\n  </div>\n</div>",
        "options": {}
      },
      "notes": "Uses existing email credentials. Update credential in node if needed."
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Format Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Lead Data": {
      "main": [
        [
          {
            "node": "Store in n8n Database",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Email Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [
    {
      "name": "dev"
    },
    {
      "name": "leads"
    }
  ]
}
