0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px\"><tr><td><h2 style=\"margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:18px;font-weight:700;color:#12111a;text-transform:uppercase;letter-spacing:0.5px\">Additional Notes</h2></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:32px\"><tr><td style=\"padding:20px;background-color:#f9fafb;border:1px solid #e5e7eb;border-left:4px solid #6b7280;border-radius:4px\"><p style=\"margin:0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#374151;white-space:pre-wrap\">{{ $json.notes }}</p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:32px\"><tr><td style=\"padding:16px;background-color:#12111a;border-radius:4px\"><p style=\"margin:0 0 4px 0;font-family:'Courier New',Courier,monospace;font-size:12px;color:#9ca3af\"><span style=\"color:#10b981\">STATUS:</span> {{ $json.status }}</p><p style=\"margin:0;font-family:'Courier New',Courier,monospace;font-size:12px;color:#9ca3af\"><span style=\"color:#ff5f00\">RECEIVED:</span> {{ $json.timestamp }}</p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px\"><tr><td align=\"center\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td style=\"padding-right:12px\"><a href=\"mailto:{{ $json.email }}\" style=\"background-color:#ff5f00;border:2px solid #ff5f00;border-radius:8px;color:#ffffff;display:inline-block;font-family:'Inter',Arial,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.5px;line-height:1.4;padding:12px 24px;text-align:center;text-decoration:none;text-transform:uppercase\">Reply to Lead</a></td><td><a href=\"tel:{{ $json.phone }}\" style=\"background-color:transparent;border:2px solid #12111a;border-radius:8px;color:#12111a;display:inline-block;font-family:'Inter',Arial,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.5px;line-height:1.4;padding:12px 24px;text-align:center;text-decoration:none;text-transform:uppercase\">Call Lead</a></td></tr></table></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td style=\"padding:16px;background-color:#fef3c7;border:1px solid #fde68a;border-radius:4px;text-align:center\"><p style=\"margin:0;font-family:'Inter',Arial,sans-serif;font-size:13px;line-height:1.5;color:#92400e\"><strong>Internal:</strong> This lead was captured via the website intake form. Follow up within 24 hours.</p></td></tr></table></td></tr></table></td></tr><tr><td style=\"padding:0 24px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td style=\"border-top:1px solid #e5e7eb;padding:0\"></td></tr></table></td></tr><tr><td style=\"padding:32px 24px;background-color:#f9fafb\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td align=\"center\" style=\"padding-bottom:16px\"><p style=\"margin:0;font-family:'Courier New',Courier,monospace;font-size:12px;line-height:1.5;color:#6b7280\"><strong style=\"color:#12111a\">WRANNGLE SYSTEMS LLC</strong><br>Industrial-Grade AI Automation</p></td></tr><tr><td align=\"center\" style=\"padding-bottom:16px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 auto\"><tr><td style=\"padding:0 8px\"><a href=\"https://wranngle.com\" style=\"color:#ff5f00;text-decoration:none;font-size:12px;font-weight:600\">Website</a></td><td style=\"padding:0 8px;color:#e5e7eb\">|</td><td style=\"padding:0 8px\"><a href=\"https://wranngle.com/terms\" style=\"color:#6b7280;text-decoration:none;font-size:12px\">Terms</a></td><td style=\"padding:0 8px;color:#e5e7eb\">|</td><td style=\"padding:0 8px\"><a href=\"https://wranngle.com/privacy\" style=\"color:#6b7280;text-decoration:none;font-size:12px\">Privacy</a></td></tr></table></td></tr><tr><td align=\"center\"><p style=\"margin:0;font-size:11px;line-height:1.5;color:#9ca3af\">© 2026 Wranngle Systems LLC. All rights reserved.</p></td></tr></table></td></tr></table></td></tr></table></body></html>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "YOUR_EMAIL_CREDENTIAL_ID",
          "name": "Wranngle Email"
        }
      },
      "notes": "Configure email credentials: In n8n, edit this node and select your SMTP/SendGrid credential from the dropdown."
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Format Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Lead Data": {
      "main": [
        [
          {
            "node": "Send Email Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
