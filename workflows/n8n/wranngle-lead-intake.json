px 0\"><tr><td align=\"center\" valign=\"top\"><table role=\"presentation\" class=\"container\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"max-width:600px;width:100%;background-color:#ffffff;margin:0 auto\"><tr><td align=\"center\" style=\"padding:32px 24px;background-color:#12111a\"><a href=\"https://wranngle.com\" style=\"text-decoration:none\"><img src=\"https://i.ibb.co/WWFmbjKJ/wranngle-wordmark-4096w.png\" alt=\"Wranngle\" width=\"180\" height=\"auto\" style=\"display:block;max-width:180px;height:auto;border:0\"/></a></td></tr><tr><td style=\"padding:0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td style=\"padding:40px 24px;border-left:4px solid #ff5f00\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:32px\"><tr><td align=\"center\" style=\"padding:24px;background:linear-gradient(135deg,#12111a 0%,#2d0914 100%);border-radius:8px\"><h1 style=\"margin:0 0 12px 0;font-family:'Inter',Arial,sans-serif;font-size:28px;font-weight:700;color:#ffffff;line-height:1.2\">New Lead Received</h1><p style=\"margin:0;font-family:'Courier New',Courier,monospace;font-size:14px;color:#ff5f00;letter-spacing:1px\">[ INTAKE FORM SUBMISSION ]</p></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px\"><tr><td><h2 style=\"margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:18px;font-weight:700;color:#12111a;text-transform:uppercase;letter-spacing:0.5px\">Business Information</h2></td></tr></table><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px\"><tr><td style=\"padding:20px;background-color:#f9fafb;border:1px solid #e5e7eb;border-left:4px solid #ff5f00;border-radius:4px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td 