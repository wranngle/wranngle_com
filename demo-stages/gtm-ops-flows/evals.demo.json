  "steps": [
    {"action": "waitForSelector", "selector": "[aria-label^=\"Evals\"]", "timeoutMs": 20000, "label": "Console ready"},
    {"action": "caption", "text": "Evals keep prompt changes measurable — the harness runs against real transcripts.", "ms": 2800, "label": "Intro"},
    {"action": "pause", "ms": 1000, "label": "Settle"},
    {"action": "focus", "selector": "[aria-label^=\"Evals\"]", "label": "Move to Evals"},
    {"action": "click", "selector": "[aria-label^=\"Evals\"]", "label": "Open Evals"},
    {"action": "resetZoom", "label": "Back to full frame"},
    {"action": "pause", "ms": 1600, "label": "Let the eval grid render"},
    {"action": "caption", "text": "Each scenario carries a score, evidence, and the ElevenLabs lab it ran in.", "ms": 2800, "label": "Detail beat"},
    {"action": "scroll", "y": 200, "label": "Scroll the eval results"},
