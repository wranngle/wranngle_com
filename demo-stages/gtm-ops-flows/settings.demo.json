{
  "name": "gtm-ops-settings",
  "startUrl": "console/?route=settings",
  "viewport": {"width": 1600, "height": 900},
  "record": {"enabled": true, "size": {"width": 1600, "height": 900}},
  "timing": {"speed": 1, "moveMs": 240, "clickPauseMs": 300, "scrollPauseMs": 260, "zoomMs": 420},
  "polish": {
    "cursor": {"style": "modern", "accentColor": "#ff5f00"},
    "actionRail": {"enabled": false},
    "captions": {"enabled": true, "position": "bottom"},
    "zoom": {"defaultScale": 1.05, "durationMs": 420, "resetMs": 300}
  },
  "metadata": {"route": "settings", "pov": "prospect"},
  "steps": [
    {"action": "waitForSelector", "selector": "[aria-label=\"Settings\"]", "timeoutMs": 20000, "label": "Console ready"},
    {"action": "caption", "text": "Settings closes on governance — alert consent, parity, and integration control.", "ms": 2800, "label": "Intro"},
    {"action": "pause", "ms": 1000, "label": "Settle"},
    {"action": "focus", "selector": "[aria-label=\"Settings\"]", "label": "Move to Settings"},
    {"action": "click", "selector": "[aria-label=\"Settings\"]", "label": "Open Settings"},
    {"action": "resetZoom", "label": "Back to full frame"},
    {"action": "pause", "ms": 1600, "label": "Let the settings panel render"},
    {"action": "caption", "text": "Alert consent and data parity are first-class, not buried in an admin tab.", "ms": 2800, "label": "Detail beat"},
    {"action": "scroll", "y": 200, "label": "Scroll the settings sections"},
    {"action": "caption", "text": "Every surface a buyer audits before they trust the agent with live calls.", "ms": 2600, "label": "Close beat"},
    {"action": "pause", "ms": 1600, "label": "Hold final frame"},
    {"action": "screenshot", "name": "settings", "label": "Poster frame"}
  ]
}
