# wranngle_com — Environment Configuration
# Copy this file to .env and fill in your values.
# Cloudflare Pages Functions read these from the Cloudflare dashboard at runtime;
# locally `wrangler pages dev` reads them from .env.

# ===================================
# Cloudflare Pages Functions (production runtime)
# ===================================
# n8n webhook the lead-capture function POSTs to.
N8N_WEBHOOK_URL=
# Shared secret sent as X-Webhook-Secret on outgoing webhooks.
N8N_WEBHOOK_SECRET=
# CORS origin allowlist for the leads endpoint (comma-separated).
ALLOWED_ORIGIN=
# Public site URL — checkout function uses it to build success/cancel
# redirect URLs back to the SPA after Stripe-hosted checkout.
SITE_URL=

# ===================================
# Stripe (checkout + webhook functions)
# ===================================
# Stripe secret key (sk_live_… or sk_test_…) — used by checkout.ts to
# create Checkout sessions and by stripe-webhook.ts to verify events.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) — used by stripe-webhook.ts to verify
# inbound webhook signatures.
STRIPE_WEBHOOK_SECRET=

# ===================================
# Email (SendGrid / SMTP2GO)
# ===================================
# SendGrid API key (welcome-email function).
SENDGRID_API_KEY=
# Default From address for outbound transactional email.
FROM_EMAIL=
# SMTP2GO key for the smtp2go-health and email-e2e scripts.
SMTP2GO_API_KEY=

# ===================================
# n8n management scripts
# ===================================
N8N_API_KEY=
N8N_API_URL=
# Workflow ID used by the build-n8n-email script.
N8N_WORKFLOW_ID=
# Override repo root for build scripts (defaults to script dir parent).
PROJECT_ROOT=

# ===================================
# Twilio (test scripts)
# ===================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ===================================
# ElevenLabs (test scripts)
# ===================================
ELEVENLABS_API_KEY=

# ===================================
# Tests
# ===================================
# Set to "true" to enable e2e tests in tests/e2e/message-delivery.test.ts
# (real SMS/email send).
RUN_E2E=false
# Set to "1" or "true" to enable integration tests under tests/integration/
# (live ElevenLabs, n8n, lead-intake notification suites). The
# `bun run test:integration` script flips this automatically.
RUN_LIVE_INTEGRATION=
TEST_PHONE_NUMBER=
TEST_RECIPIENT_EMAIL=
# Override placeholder secret used by lead-intake notification tests.
SMS_WEBHOOK_SECRET=
