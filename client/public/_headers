# Cloudflare Pages response-header overrides.
# https://developers.cloudflare.com/pages/configuration/headers/

# Site-wide security baseline. Cloudflare adds CF-managed headers on top
# (CF-Ray, NEL, etc.); these are the ones the application owns.
/*
  # HSTS — tell browsers to ALWAYS use HTTPS for wranngle.com and its
  # subdomains for the next year, and signal intent to be in the
  # Chromium preload list. Safe because the apex + www both already
  # serve HTTPS; without HSTS, a first visit could be MITM-downgraded
  # to HTTP. Once preloaded, even a never-visited browser bypasses HTTP.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Clickjacking — refuse iframe embedding of any wranngle.com page.
  # Site has no legitimate iframe-embed use case; stricter than
  # SAMEORIGIN to also block accidental subdomain framing.
  X-Frame-Options: DENY

  # Permissions-Policy — explicitly grant microphone to self (the
  # ElevenLabs ConvAI widget runs as a custom element on this origin
  # so self alone is enough; the widget's actual audio capture also
  # happens via the page's getUserMedia, not a cross-origin iframe).
  # Deny everything else by default — visitor browsers won't even ask
  # for camera/geolocation/payment/usb/etc. on this site.
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), display-capture=(), fullscreen=(self)

# Hashed bundles in /assets/* — content-addressable, so cache forever.
# Vite includes a content hash in every filename (index-DpOR-9It.js etc.),
# so a redeploy ships a new URL and the old one stays valid in caches
# without ever needing revalidation. CF's default of max-age=14400 forces
# re-download every 4 hours for no reason on returning visitors.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Other immutable static files served from the root. Same reasoning:
# the file is small, not version-bumped, but rarely changes; long cache
# is fine and a hash-busted reload is a force-refresh anyway.
/og-image.jpg
  Cache-Control: public, max-age=2592000, must-revalidate
/portrait-cody.jpg
  Cache-Control: public, max-age=2592000, must-revalidate
/sample-proposal.pdf
  Cache-Control: public, max-age=2592000, must-revalidate
/favicon.png
  Cache-Control: public, max-age=2592000, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, must-revalidate
/wordmark.png
  Cache-Control: public, max-age=2592000, must-revalidate
